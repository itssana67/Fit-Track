# ------------------------------------------------------------
# FitTrack backend environment variables
# Copy this file to ".env" and fill in real values.
# Never commit your real .env file.
# ------------------------------------------------------------

# Port the Express server listens on
PORT=5000
NODE_ENV=development

# MongoDB connection string used by Prisma.
# Prisma needs MongoDB running as a REPLICA SET (MongoDB Atlas already is).
# Atlas example (replace user, password, cluster and keep the database name):
DATABASE_URL="mongodb+srv://fittrack_app:xxwXvZN9ooKt6484@cluster0.cgyal2p.mongodb.net/Fit-Track?retryWrites=true&w=majority"
# Local replica set example:
# DATABASE_URL="mongodb://127.0.0.1:27017/fittrack?replicaSet=rs0&directConnection=true"

# Secret used to sign JWT tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=19fa470a7cf6bb7ee84de47635dab526646d554e0752f339b0f32456ed14236c
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS (comma separated for more than one)
CLIENT_URL=http://localhost:5173

# External exercise API (API Ninjas - https://api-ninjas.com/api/exercises)
# Leave empty to use the built-in exercise library stored in MongoDB.
EXERCISE_API_KEY=
EXERCISE_API_URL=https://api.api-ninjas.com/v1/exercises
