{
  "name": "fittrack-backend",
  "version": "1.0.0",
  "description": "FitTrack REST API - Node.js, Express, Prisma and MongoDB",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "seed:clear": "node prisma/seed.js --clear",
    "setup": "prisma generate && prisma db push && node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.16.0"
  },
  "engines": {
    "node": ">=18"
  }
}
